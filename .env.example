# Generate a strong local password. Never commit .env.
POSTGRES_PASSWORD=
# Development only for a local HTTP demo. Use Production behind HTTPS.
APP_ENVIRONMENT=Development
UI_PORT=8088
# Private Cloudflare R2 bucket, provisioned before running the application.
# Use bucket-scoped S3 credentials; keep dev/test/production separate.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=ekt-reports-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
