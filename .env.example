# Copy to .env (never commit it) and chmod 600 on a server.
# Generate a strong password, for example: openssl rand -base64 33
POSTGRES_PASSWORD=

# Production on a server. Development relaxes cookie security and enables demo provisioning:
# use it only for a local HTTP demo, never on a VPS.
APP_ENVIRONMENT=Production

# Local demo port (compose.yaml alone).
UI_PORT=8088

# Private Cloudflare R2 bucket, provisioned before running the application.
# Use bucket-scoped S3 credentials; keep dev/test/production buckets separate and never reuse a test bucket.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- HTTPS on a VPS (compose.yaml + compose.https.yaml) ---
# The https origin users open, without a trailing slash. Every emailed link is built from it.
PUBLIC_URL=https://keeptrack.example.com
# Certificate and key files outside Git, e.g. Let's Encrypt:
#   /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem
TLS_CERT_PATH=
TLS_KEY_PATH=
# Defaults bind to 127.0.0.1 for local testing. On a VPS publish 443/80:
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# --- Email (verification, password reset). Leave SMTP_HOST empty and no email is delivered. ---
# STARTTLS on port 587 is supported; implicit TLS on port 465 is not.
# Gmail (set SMTP_HOST=smtp.gmail.com): user = the Gmail address, password = a 16-character App Password
# (needs 2-step verification), SMTP_FROM must be that address or an alias.
# SMTP_HOST=smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
