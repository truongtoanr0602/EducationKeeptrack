      Executed DbCommand (7ms) [Parameters=[@owner='?', @classId='?' (DbType = Guid), @date='?' (DbType = Date), @date4='?' (DbType = Date)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT s."Id", s."Email", s."Name", s."Notes", s."OwnerId", s."ParentName", s."Phone", s."Version"&#xD;
      FROM classroom."Students" AS s&#xD;
      WHERE s."OwnerId" = @owner AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM classroom."Enrollments" AS e&#xD;
          WHERE e."StudentId" = s."Id" AND e."OwnerId" = @owner AND e."ClassId" = @classId AND e."StartDate" &lt;= @date AND (e."EndDate" IS NULL OR e."EndDate" &gt;= @date4))&#xD;
      ORDER BY s."Name", s."Id"&#xD;
