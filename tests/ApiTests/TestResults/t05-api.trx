      FROM classroom."Attendance" AS a&#xD;
      INNER JOIN classroom."Students" AS s ON a."StudentId" = s."Id"&#xD;
      WHERE a."OwnerId" = @owner AND a."SessionId" = @sessionId AND s."OwnerId" = @owner&#xD;
      ORDER BY s."Name", s."Id"&#xD;
