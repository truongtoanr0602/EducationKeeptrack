      SELECT s0."Id", s0."AssessmentId", s0."Completion", s0."Correctness", s0."Method", s0."Status", s0."StudentId", s0."StudentName", s0."Version", r."Id", r."Action", r."Completion", r."Correctness", r."DispatchedAt", r."Method", r."RecordedAt", r."Status", r."SubmissionId", r."Version"&#xD;
      FROM (&#xD;
